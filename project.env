# Project identity: the single source of truth for every name derived from the
# project name (binaries, images, Helm defaults, metric prefix, CSAR, docs).
#
# Sourced by shell scripts, parsed by CMake (cmake/project.cmake) and Python
# (tools/project.py). Keep it plain KEY=value: no quotes, no spaces.
#
# To rename the project, run `tools/rename.sh <new-name>`; it also rewrites
# the few places that cannot read this file (see tools/rename.sh).

PROJECT_NAME=dsp
METRIC_PREFIX=dsp
VENDOR=gk72
