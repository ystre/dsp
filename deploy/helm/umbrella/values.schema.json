{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Integration chart values (component values are validated by the subcharts)",
  "type": "object",
  "required": ["server", "topics", "kafka", "loadgen"],
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": { "registry": { "type": "string" }, "tag": { "type": "string" } },
          "additionalProperties": false
        }
      }
    },
    "server":  { "type": "object", "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } } },
    "topics": {
      "type": "object",
      "required": ["enabled", "cluster", "clusterNamespace", "prefix", "items"],
      "properties": {
        "enabled": { "type": "boolean" },
        "cluster": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "clusterNamespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "prefix": { "type": "string", "pattern": "^[a-zA-Z0-9._-]*$", "maxLength": 200 },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "partitions", "replicas"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$", "maxLength": 48 },
              "partitions": { "type": "integer", "minimum": 1 },
              "replicas": { "type": "integer", "minimum": 1 },
              "config": { "type": "object" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "kafka":   { "type": "object", "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } } },
    "loadgen": { "type": "object", "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } } }
  }
}
