{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Dependencies chart values (subchart values are validated by the subcharts)",
  "type": "object",
  "properties": {
    "kube-prometheus-stack": { "type": "object", "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } } },
    "strimzi-kafka-operator": { "type": "object", "required": ["enabled"], "properties": { "enabled": { "type": "boolean" }, "watchAnyNamespace": { "type": "boolean" } } },
    "kafka": { "type": "object", "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } } }
  }
}
