{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Load generator chart values",
  "type": "object",
  "required": ["image", "binaries", "instances", "run", "metrics"],
  "properties": {
    "enabled": { "type": "boolean", "description": "Set by the umbrella chart's condition." },
    "global": { "type": "object" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": { "type": "array" },
    "binaries": {
      "type": "object",
      "required": ["loadgen"],
      "properties": { "loadgen": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "target": { "type": "string", "pattern": "^$|^.+:[0-9]+$" },
    "instances": { "type": "integer", "minimum": 1 },
    "run": {
      "type": "object",
      "required": ["transport", "mode", "type", "connections", "threads", "rate", "payload", "count", "duration"],
      "properties": {
        "transport": { "enum": ["tcp", "udp", "ws", "unix"] },
        "mode": { "enum": ["closed-loop", "open-loop", "churn", "idle-fanout"] },
        "type": { "enum": ["data", "echo", "req"] },
        "connections": { "type": "integer", "minimum": 1 },
        "threads": { "type": "integer", "minimum": 1 },
        "rate": { "type": "number", "minimum": 0 },
        "payload": { "type": "string", "pattern": "^(fixed:[0-9]+|uniform:[0-9]+:[0-9]+)$" },
        "aux": { "type": "integer", "minimum": 0 },
        "batch": { "type": "integer", "minimum": 1 },
        "count": { "type": "integer", "minimum": 0 },
        "duration": { "type": "number", "minimum": 0 },
        "warmup": { "type": "number", "minimum": 0 },
        "scenario": { "type": "string" }
      },
      "additionalProperties": false
    },
    "extraArgs": { "type": "array" },
    "metrics": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "linger": { "type": "number", "minimum": 0 },
        "podMonitor": { "type": "object" }
      },
      "additionalProperties": false
    },
    "job": { "type": "object" },
    "sysctls": { "type": "array" },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "hostNetwork": { "type": "boolean" },
    "placement": {
      "type": "object",
      "properties": { "dedicatedNodes": { "type": "boolean" } },
      "additionalProperties": false
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "podLabels": { "type": "object" },
    "podAnnotations": { "type": "object" }
  },
  "additionalProperties": false
}
